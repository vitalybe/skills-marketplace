#!/usr/bin/env bash
# Is this session an orchestrated run - an interactive coding agent in a platform
# pod, whose output the orchestrator backend scans - or anything else?
#
# Prints `yes` or `no` and always exits 0. `start-flow` injects it as a skill
# `!`...`` block, which the harness statically verifies - so the command string
# there has to stay a single plain invocation, and all the branching lives here.
#
# Deliberately NOT keyed on which agent is running. The platform spawns
# `cursor_agent` and `codex` today (drivenets/agents, coding_agents/consumer.py)
# and Claude Code elsewhere; every one of them has to reach the same answer.
#
# Deliberately narrow, too. `yes` means "someone is reading the markers and can
# clear a gate", so it takes an interactive session and nothing less: a plain
# `spawn_coding_agent` pod, or any other EC2 box, answers `no`. A false `yes`
# there would stop start-flow at its human gate with no UI to clear it and the
# run would never close - worse than the missing phase panel a false `no` costs.
set -uo pipefail

yes() { printf 'yes\n'; exit 0; }
no()  { printf 'no\n';  exit 0; }

# 1. Explicit override, and it wins in both directions. Not required from the
#    platform - kept so a run can be forced either way.
case "${ORCHESTRATOR_ENVIRONMENT:-}" in
  '')                 ;;  # unset: fall through to the real signals
  0 | no | false) no  ;;
  *)              yes ;;
esac

# 2. The platform's interactive-coding contract, forwarded by the consumer only
#    for a resumable session - that is, the orchestrator's own
#    spawn_interactive_coding_agent, the one run whose output is scanned:
#      CODING_SESSION_ID     stable session key within the parent job
#      SESSION_ARTIFACT_REF  the session bundle, resumable runs only
#    Both, because the artifact ref is dropped when the steps Lambda call fails.
#    AGENT_TYPE is NOT used: it marks every pod, interactive or not.
#    See build_agent_env / run_task in drivenets/agents.
[ -n "${CODING_SESSION_ID:-}" ] && yes
[ -n "${SESSION_ARTIFACT_REF:-}" ] && yes

# 3. Claude Code's own marker for a remote/web session, set to "true" there and
#    left unset by the local CLI, for the runs that are Claude Code.
#    https://code.claude.com/docs/en/hooks.md
[ "${CLAUDE_CODE_REMOTE:-}" = "true" ] && yes

no
